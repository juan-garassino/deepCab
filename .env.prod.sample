# Copy to .env.prod. Loaded when DEEPCAB_ENV=prod.
# Points at the prod GCP project's Cloud Run services + Cloud SQL.
# Sensitive values come from Secret Manager via Cloud Run secret_env_vars.

DEEPCAB_ENV=prod

# Data
DATA_SOURCE=cloud
DATA_LOCAL_PATH=/var/lib/deepcab/data
DATA_PARQUET_PATH=/var/lib/deepcab/data/parquet
DATA_CHUNK_SIZE=4000
DATA_DATASET_SIZE=full
DATA_VALIDATION_DATASET_SIZE=full

# Registry
REGISTRY_TARGET=gcs
REGISTRY_LOCAL_PATH=/tmp/mlops-registry
REGISTRY_BUCKET_NAME=deepcab-models-prod

# GCP
GCP_PROJECT_ID=deepcab-prod
GCP_DATASET=

# MLflow — prod tracking server (custom domain via Cloud DNS)
MLFLOW_TRACKING_URI=https://mlflow.deepcab.com
MLFLOW_EXPERIMENT=deepcab-prod
MLFLOW_MODEL_NAME=deepcab
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# Observability
OBS_OTLP_ENDPOINT=
OBS_SERVICE_NAME=deepcab-api
OBS_PROM_PORT=9090
OBS_TRACE_DIR=/tmp/traces
OBS_TRACE_ENABLED=true

# OpenAI — pulled from Secret Manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
