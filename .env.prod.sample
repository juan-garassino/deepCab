# DEPRECATED (2026-06-07): the `prod` GCP env is no longer funded under the
# €25/mo cap. Only `dev` is live, on `garassino-ml` in `europe-west1`.
#
# Kept as a template if a paid prod env is later reintroduced. Update
# project + region + secret URIs before reuse — do NOT copy as-is.

DEEPCAB_ENV=prod

# Data
DATA_SOURCE=cloud
DATA_LOCAL_PATH=/var/lib/deepcab/data
DATA_PARQUET_PATH=/var/lib/deepcab/data/parquet
DATA_CHUNK_SIZE=4000
DATA_DATASET_SIZE=full
DATA_VALIDATION_DATASET_SIZE=full

# Registry
REGISTRY_TARGET=gcs
REGISTRY_LOCAL_PATH=/tmp/mlops-registry
REGISTRY_BUCKET_NAME=                   # set when reactivated

# GCP
GCP_PROJECT_ID=                         # set when reactivated
GCP_DATASET=

# MLflow
MLFLOW_TRACKING_URI=                    # set when reactivated
MLFLOW_EXPERIMENT=deepcab-prod
MLFLOW_MODEL_NAME=deepcab
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# Observability
OBS_OTLP_ENDPOINT=
OBS_SERVICE_NAME=deepcab-api
OBS_PROM_PORT=9090
OBS_TRACE_DIR=/tmp/traces
OBS_TRACE_ENABLED=true

# OpenAI — pulled from Secret Manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
