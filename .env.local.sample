# Copy to .env.local. Loaded by pydantic-settings when DEEPCAB_ENV=local
# (or its legacy alias APP_ENV=local). All groups are namespaced with prefixes;
# see deepCab/schemas/settings.py.
#
# "local" means: everything runs in docker-compose on this machine. Hostnames
# resolve over the compose network (postgres, mlflow, minio, redis, etc.).

DEEPCAB_ENV=local

# Data
DATA_SOURCE=local
DATA_LOCAL_PATH=~/.lewagon/mlops/data
DATA_PARQUET_PATH=~/.lewagon/mlops/data/parquet
DATA_CHUNK_SIZE=2000
DATA_DATASET_SIZE=1k
DATA_VALIDATION_DATASET_SIZE=1k

# Registry — local filesystem under runs/
REGISTRY_TARGET=local
REGISTRY_LOCAL_PATH=~/.lewagon/mlops/training_outputs
REGISTRY_BUCKET_NAME=

# GCP — unused in local mode
GCP_PROJECT_ID=
GCP_DATASET=

# MLflow — hits the compose mlflow service over the compose network
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=deepcab-local
MLFLOW_MODEL_NAME=deepcab
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# Observability — local otel-collector / prometheus / grafana stack
OBS_OTLP_ENDPOINT=http://otel-collector:4317
OBS_SERVICE_NAME=deepcab
OBS_PROM_PORT=9090
OBS_TRACE_DIR=traces
OBS_TRACE_ENABLED=true

# OpenAI (agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
