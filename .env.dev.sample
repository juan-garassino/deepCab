# Copy to .env.dev. Loaded by pydantic-settings when APP_ENV=dev (the default).
# All groups are namespaced with prefixes; see deepCab/schemas/settings.py.
#
# Cloud target (post-2026-06-07): garassino-ml in europe-west1.
# Show-and-destroy: `make showcase_up` provisions, `make showcase_down` tears down.

APP_ENV=dev

# Data
# DATA_SOURCE=local           → bootstrap path: Lewagon CSVs in DATA_LOCAL_PATH
# DATA_SOURCE=query           → simulation path: BigQuery via DATA_BQ_*
DATA_SOURCE=local
DATA_LOCAL_PATH=~/.lewagon/mlops/data
DATA_PARQUET_PATH=~/.lewagon/mlops/data/parquet
DATA_CHUNK_SIZE=2000
DATA_DATASET_SIZE=1k
DATA_VALIDATION_DATASET_SIZE=1k

# BigQuery ingest (only consumed when DATA_SOURCE=query)
DATA_BQ_PROJECT=garassino-ml
DATA_BQ_DATASET=taxi
DATA_BQ_TABLE=yellow_trips_raw

# Registry
REGISTRY_TARGET=local
REGISTRY_LOCAL_PATH=~/.lewagon/mlops/training_outputs
REGISTRY_BUCKET_NAME=

# GCP (only needed when REGISTRY_TARGET=gcs or DATA_SOURCE=query)
GCP_PROJECT_ID=garassino-ml
GCP_DATASET=taxi

# MLflow (local compose, or Neon-backed Cloud Run MLflow via showcase_up)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=deepcab-dev
MLFLOW_MODEL_NAME=deepcab
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_CHALLENGER_ALIAS=challenger

# Observability
OBS_OTLP_ENDPOINT=http://localhost:4317
OBS_SERVICE_NAME=deepcab
OBS_PROM_PORT=9090
OBS_TRACE_DIR=traces
OBS_TRACE_ENABLED=true

# OpenAI (agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
